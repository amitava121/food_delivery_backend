# Local dev — async driver required (create_async_engine)
DATABASE_URL=sqlite+aiosqlite:///./qr_orders.db

# Supabase Postgres — session pooler (Dashboard → Connect)
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?ssl=require

SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Cloudflare R2 image upload (via r2-uploader worker)
R2_UPLOAD_URL=https://<your-worker>.workers.dev
R2_UPLOAD_KEY=<upload-key>
R2_PUBLIC_URL=https://pub-<id>.r2.dev

# Firebase web API key (public — used to verify Google ID tokens)
FIREBASE_API_KEY=<firebase-web-api-key>
